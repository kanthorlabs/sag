FROM docker.io/library/golang:1.27.4-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 go build -trimpath \
    -ldflags "-X github.com/kanthorlabs/sag/internal/cli.Version=${VERSION}" \
    -o /out/sag ./cmd/sag
RUN mkdir -p /out/lib/sag/audit /out/lib/sag/approvals \
    && chmod 0700 /out/lib/sag /out/lib/sag/audit /out/lib/sag/approvals

FROM gcr.io/distroless/base-debian12:nonroot
COPY --from=build /out/sag /usr/local/bin/sag
COPY --from=build --chown=65532:65532 /out/lib/ /var/lib/
USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/sag"]
CMD ["serve"]
