[Unit]
Description=SAG Secure Access Gateway
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=sag
Image=localhost/sag:latest
Exec=serve
ReadOnly=true
User=65532
Group=65532
DropCapability=all
NoNewPrivileges=true
PublishPort=127.0.0.1:8443:8443
Volume=/etc/sag/sag.yaml:/etc/sag/sag.yaml:ro
Volume=sag-state:/var/lib/sag
Secret=sag-master-key,type=mount,target=sag-master-key,uid=65532,mode=0400
Secret=sag-tls-cert,type=mount,target=sag-tls-cert,uid=65532,mode=0400
Secret=sag-tls-key,type=mount,target=sag-tls-key,uid=65532,mode=0400
Secret=sag-orders,type=mount,target=sag-orders,uid=65532,mode=0400
Secret=sag-dev-pg-ca,type=mount,target=sag-dev-pg-ca,uid=65532,mode=0400

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
